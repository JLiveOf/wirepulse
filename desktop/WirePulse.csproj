<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
  <EnableWindowsTargeting>true</EnableWindowsTargeting><OutputType>WinExe</OutputType>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <ApplicationIcon>Assets/WirePulse.ico</ApplicationIcon><AssemblyName>WirePulse</AssemblyName><Version>4.1.0</Version><AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
 </PropertyGroup>
 <ItemGroup><EmbeddedResource Include="Assets/en.json"/></ItemGroup>
 <ItemGroup>
  <PackageReference Include="Avalonia" Version="12.1.6"/><PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
  <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6"/><PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6"/><PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6"/>
  <InternalsVisibleTo Include="Performance"/><AvaloniaResource Include="Assets/**"/><Compile Remove="tests/**/*.cs"/><Compile Remove="WindowsSettings/**/*.cs"/>
 </ItemGroup>
 <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"><ApplicationManifest>Properties/app.manifest</ApplicationManifest></PropertyGroup>
 <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
  <PackageReference Include="Vortice.Direct3D11" Version="3.8.3"/><PackageReference Include="Vortice.Direct2D1" Version="3.8.3"/><PackageReference Include="Vortice.D3DCompiler" Version="3.8.3"/><PackageReference Include="Vortice.MediaFoundation" Version="3.8.3"/>
  <PackageReference Include="NAudio" Version="2.2.1"/><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35"/>
 </ItemGroup>
 <ItemGroup><None Include="Assets/controls.json" CopyToOutputDirectory="PreserveNewest"/><None Include="Assets/WirePulse.png" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
 <Target Name="UseOnlyWebView2Core" BeforeTargets="ResolveAssemblyReferences" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'"><ItemGroup><Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('.Wpf')) Or $([System.String]::Copy('%(Filename)').EndsWith('.WinForms'))"/></ItemGroup></Target>
</Project>
