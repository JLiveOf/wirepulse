<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
  <EnableWindowsTargeting>true</EnableWindowsTargeting><OutputType>WinExe</OutputType>
  <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  <ApplicationIcon>Assets/WirePulse.ico</ApplicationIcon><AssemblyName>WirePulse</AssemblyName><Version>2.5.0</Version><AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
 </PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Avalonia" Version="12.1.6"/><PackageReference Include="Avalonia.Desktop" Version="12.1.6"/>
  <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6"/><PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6"/>
  <InternalsVisibleTo Include="Performance"/><AvaloniaResource Include="Assets/**"/><Compile Remove="tests/**/*.cs"/>
 </ItemGroup>
 <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
  <PackageReference Include="NAudio" Version="2.2.1"/>
 </ItemGroup>
 <ItemGroup><None Include="Assets/controls.json" CopyToOutputDirectory="PreserveNewest"/><None Include="Assets/WirePulse.png" CopyToOutputDirectory="PreserveNewest"/></ItemGroup>
</Project>
